<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:models="clr-namespace:MediCare.Mobile.Models"
             xmlns:f="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MediCare.Mobile.Pages.AppointmentsPage"
             x:DataType="pageModels:AppointmentsPageModel"
             x:Name="AppointmentsRoot"
             Title="My Appointments">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference AppointmentsRoot}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource LayoutPadding}" RowSpacing="12">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView x:Name="AppointmentsList"
                            ItemsSource="{Binding Appointments}"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppointmentVm">
                        <Border Style="{StaticResource ListCardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        BackgroundColor="{StaticResource Primary}"
                                        WidthRequest="52" HeightRequest="52" VerticalOptions="Start">
                                    <Label Text="{x:Static f:FluentUI.calendar_clock_24_regular}"
                                           FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="26"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding DoctorName}" Style="{StaticResource Body1Strong}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding TimeText}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="12" HorizontalOptions="End">
                                    <Border Style="{StaticResource ChipStyle}"
                                            BackgroundColor="{Binding StatusColor}">
                                        <Label Text="{Binding StatusText}" TextColor="White"
                                               FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="{x:Static f:FluentUI.chevron_right_24_regular}"
                                           FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18"
                                           Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Padding="0,60">
                        <Label Text="{x:Static f:FluentUI.calendar_ltr_24_regular}"
                               FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="48"
                               Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                        <Label Text="No appointments yet" Style="{StaticResource Body1Strong}" HorizontalOptions="Center" />
                        <Label Text="Book your first visit below." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="Book Appointment" Command="{Binding BookCommand}"
                CornerRadius="24" HeightRequest="48" />
    </Grid>
</ContentPage>
