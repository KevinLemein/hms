<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MediCare.Mobile.Pages.AppointmentDetailPage"
             x:DataType="pageModels:AppointmentDetailPageModel"
             x:Name="DetailRoot"
             Title="Appointment">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference DetailRoot}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Appointment.DoctorName}" Style="{StaticResource Title3}" />
                        <Label Grid.Column="1" Text="{Binding Appointment.StatusText}"
                               TextColor="{Binding Appointment.StatusColor}"
                               FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Appointment.DateText, StringFormat='Date: {0}'}" Style="{StaticResource Body2}" />
                    <Label Text="{Binding Appointment.TimeText, StringFormat='Time: {0}'}" Style="{StaticResource Body2}" />
                    <Label Text="{Binding Appointment.Reason, StringFormat='Reason: {0}'}" Style="{StaticResource Body2}" />
                    <Label Text="{Binding Appointment.Notes, StringFormat='Doctor notes: {0}'}" Style="{StaticResource Body2}"
                           IsVisible="{Binding Appointment.HasNotes}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Edit Appointment" Command="{Binding EditCommand}" CornerRadius="20"
                    IsVisible="{Binding CanModify}" />
            <Button Text="Cancel Appointment" Command="{Binding CancelCommand}" CornerRadius="20"
                    BackgroundColor="IndianRed" TextColor="White" IsVisible="{Binding CanModify}" />
            <Button Text="{Binding PrescriptionsText}" Command="{Binding ViewPrescriptionsCommand}" CornerRadius="20"
                    IsVisible="{Binding HasPrescriptions}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
