<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:f="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MediCare.Mobile.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="OverviewPage"
             Title="{Binding Today}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference OverviewPage}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <Style x:Key="QuickActionIcon" TargetType="Label">
                <Setter Property="FontFamily" Value="{x:Static f:FluentUI.FontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="QuickActionTile" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="0,16" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="20">

            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="20"
                    BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Welcome back" TextColor="{StaticResource Secondary}" FontSize="14" />
                        <Label Text="{Binding Member.FullName}"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding Member.IDNo}"
                               TextColor="{StaticResource Secondary}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Quick Actions" Style="{StaticResource Title2}" SemanticProperties.HeadingLevel="Level2" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource QuickActionTile}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BookAppointmentCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static f:FluentUI.calendar_add_24_regular}" Style="{StaticResource QuickActionIcon}" />
                        <Label Text="Book" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource QuickActionTile}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewAppointmentsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static f:FluentUI.calendar_ltr_24_regular}" Style="{StaticResource QuickActionIcon}" />
                        <Label Text="Appointments" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource QuickActionTile}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewPrescriptionsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static f:FluentUI.pill_24_regular}" Style="{StaticResource QuickActionIcon}" />
                        <Label Text="Prescriptions" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
