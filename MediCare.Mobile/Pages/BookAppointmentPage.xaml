<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MediCare.Mobile.Pages.BookAppointmentPage"
             x:DataType="pageModels:BookAppointmentPageModel"
             x:Name="BookRoot"
             Title="{Binding Title}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference BookRoot}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="NotEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="10">
            <Label Text="Doctor" />
            <Picker Title="Select a doctor" ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}"
                    IsEnabled="{Binding CanChangeDoctor}" />

            <Label Text="Date" Margin="0,10,0,0" />
            <DatePicker Date="{Binding SelectedDate}" MinimumDate="{Binding MinDate}" MaximumDate="{Binding MaxDate}" />

            <Label Text="Time" Margin="0,10,0,0" />
            <Picker Title="Select a time slot" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" />

            <Label Text="Reason for visit" Margin="0,10,0,0" />
            <Editor Placeholder="e.g. Persistent cough" Text="{Binding Reason}" HeightRequest="100" AutoSize="TextChanges" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}" />

            <Button Text="{Binding SubmitText}" Command="{Binding BookCommand}" CornerRadius="20" Margin="0,20,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
