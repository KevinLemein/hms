<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
             x:Class="MediCare.Mobile.Pages.PaymentHistoryPage"
             x:DataType="pageModels:PaymentHistoryPageModel"
             x:Name="HistoryPage"
             Title="Payment History">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference HistoryPage}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="NotEmptyConverter" />

            <DataTemplate x:Key="LeftCell" x:DataType="x:String">
                <Label Text="{Binding}" TextColor="Black" Padding="10,0"
                       VerticalOptions="Center" HorizontalTextAlignment="Start"
                       LineBreakMode="TailTruncation" MaxLines="1" />
            </DataTemplate>

            <DataTemplate x:Key="RightCell" x:DataType="x:String">
                <Label Text="{Binding}" TextColor="Black" Padding="10,0"
                       VerticalOptions="Center" HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation" MaxLines="1" />
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource LayoutPadding}" RowSpacing="10">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}" />

        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
            <Grid RowDefinitions="*,Auto" WidthRequest="780">

                <dg:DataGrid Grid.Row="0"
                             ItemsSource="{Binding Payments}"
                             SelectionMode="None"
                             SortingEnabled="False"
                             RefreshingEnabled="False"
                             RowHeight="48"
                             HeaderHeight="48"
                             BorderColor="#D0D0D0"
                             HeaderBackground="{StaticResource Secondary}">

                    <dg:DataGrid.HeaderLabelStyle>
                        <Style TargetType="Label">
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="HorizontalTextAlignment" Value="Start" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </dg:DataGrid.HeaderLabelStyle>

                    <dg:DataGrid.Columns>
                       
                        <dg:DataGridColumn Title="Payment Mode" PropertyName="PaymentMode" Width="130"
                                           CellTemplate="{StaticResource LeftCell}" />
                        <dg:DataGridColumn Title="Payment Type" PropertyName="PaymentType" Width="140"
                                           CellTemplate="{StaticResource LeftCell}" />
                        <dg:DataGridColumn Title="Transaction code" PropertyName="TransactionCode" Width="160"
                                           CellTemplate="{StaticResource LeftCell}" />
                        <dg:DataGridColumn Title="Payment For" PropertyName="PaymentFor" Width="130"
                                           CellTemplate="{StaticResource LeftCell}" />
                        <dg:DataGridColumn Title="Date Paid" PropertyName="DatePaid" Width="110"
                                           CellTemplate="{StaticResource LeftCell}" />
                        <dg:DataGridColumn Title="Amount" PropertyName="Amount" Width="110"
                        CellTemplate="{StaticResource RightCell}" />
                    </dg:DataGrid.Columns>

                    <dg:DataGrid.RowsBackgroundColorPalette>
                        <dg:PaletteCollection>
                            <Color>#E7E7E7</Color>
                            <Color>#FFFFFF</Color>
                        </dg:PaletteCollection>
                    </dg:DataGrid.RowsBackgroundColorPalette>

                    <dg:DataGrid.NoDataView>
                        <Label Text="No payments found." Padding="10,20" HorizontalOptions="Start" TextColor="Black" />
                    </dg:DataGrid.NoDataView>
                </dg:DataGrid>

                <Label Grid.Row="1"
                       Text="{Binding Total}"
                       FontAttributes="Bold"
                       WidthRequest="110"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="End"
                       Padding="10,14" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
