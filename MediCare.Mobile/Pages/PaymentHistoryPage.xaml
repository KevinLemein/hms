<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:MediCare.Mobile.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:MediCare.Mobile.Models"
             xmlns:f="clr-namespace:Fonts"
             x:Class="MediCare.Mobile.Pages.PaymentHistoryPage"
             x:DataType="pageModels:PaymentHistoryPageModel"
             x:Name="HistoryPage"
             Title="Payment History">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
                BindingContext="{Binding Path=BindingContext, Source={x:Reference HistoryPage}, x:DataType=ContentPage}"
                EventName="Appearing"
                Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="NotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="{StaticResource LayoutPadding}" RowSpacing="12">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="IndianRed"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmptyConverter}}" />

        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 20" StrokeThickness="0"
                Padding="20"
                BackgroundColor="{StaticResource Primary}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Total paid" TextColor="White" Opacity="0.8" FontSize="14" />
                <Label Text="{Binding Total}"
                       TextColor="White" FontSize="28" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Payments}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PaymentRow">
                    <Border Style="{StaticResource ListCardStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    WidthRequest="52" HeightRequest="52" VerticalOptions="Start">
                                <Label Text="{x:Static f:FluentUI.payment_24_regular}"
                                       FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="26"
                                       TextColor="{StaticResource Gray900}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding PaymentFor}" Style="{StaticResource Body1Strong}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DatePaid}" Style="{StaticResource MutedLabel}" />
                                <Label Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding PaymentMode}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding PaymentType}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding TransactionCode, StringFormat='Ref: {0}'}"
                                       Style="{StaticResource MutedLabel}" FontSize="12"
                                       IsVisible="{Binding TransactionCode, Converter={StaticResource NotEmptyConverter}}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="{Binding Amount}"
                                   Style="{StaticResource Body1Strong}"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Start" HorizontalTextAlignment="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Padding="0,40">
                    <Label Text="{x:Static f:FluentUI.payment_24_regular}"
                           FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="48"
                           Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                    <Label Text="No payments found" Style="{StaticResource Body1Strong}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
